  "practice_2026": {
    "id": "ising-duality-codebook",
    "audiences": [
      "physics",
      "mathematics",
      "computer_science"
    ],
    "learning_targets": [
      "simulate the classical square-lattice Ising model with local Metropolis updates",
      "recover the Onsager critical scale and compute the Kramers-Wannier dual coupling",
      "recognize the Hopfield network as an Ising-like energy model without identifying it with the Onsager lattice model",
      "solve a small transverse-field Ising model by exact diagonalization",
      "represent genus-2 Z2 homology sectors as H1(Sigma_2,Z2) ~= Z2^4",
      "distinguish local spin updates from non-contractible logical/loop operations",
      "use Montonen-Olive/S-duality as an advanced electric-magnetic strong/weak duality example, not as a Monte Carlo update rule",
      "construct and validate a contextual kernel from physical/computational observables",
      "lift 1D/2D swarmalator phase sectors into Kuramoto representations with an explicit information-loss/coherence witness",
      "compare ordinary Kuramoto coherence with swarmalator rainbow order parameters without collapsing the models"
    ],
    "evaluation": {
      "implementation": 0.3,
      "physics_and_mathematics": 0.3,
      "kernel_and_data_analysis": 0.2,
      "critical_interpretation": 0.2
    },
    "textbook_format": [
      "chapter",
      "mathematical_kernel",
      "observables",
      "executable_model",
      "experiment",
      "interpretation",
      "reproducibility_witness",
      "exercises"
    ],
    "public_install": {
      "path": "tutorials/practica-2026-ising-duality",
      "command": "python -m pip install -r requirements.txt",
      "optional_sigil4py": "python -m pip install sigil4py",
      "caveat": "optional command requires a public sigil4py distribution in the configured package source"
    },
    "required_learning_targets": [
      "simulate the classical square-lattice Ising model with local Metropolis updates",
      "recover the Onsager critical scale and compute the Kramers-Wannier dual coupling",
      "recognize the Hopfield network as an Ising-like energy model without identifying it with the Onsager lattice model",
      "solve a small transverse-field Ising model by exact diagonalization",
      "represent genus-2 Z2 homology sectors as H1(Sigma_2,Z2) ~= Z2^4",
      "distinguish local spin updates from non-contractible logical/loop operations",
      "use Montonen-Olive/S-duality as an advanced electric-magnetic strong/weak duality example, not as a Monte Carlo update rule",
      "construct and validate a contextual kernel from physical/computational observables",
      "compare the contextual/quantum construction against an explicit classical reference",
      "state the resource assumptions required before claiming quantum advantage"
    ],
    "research_appendices": {
      "assessed_in_base_course": false,
      "note": "Optional research-facing material is available in the codebook/repository but is synchronized only for TFG/TFM/PhD routes.",
      "topics": [
        "Anderson and Aubry-Andre localization",
        "circle map and Arnold tongues",
        "Kuramoto synchronization",
        "1D/2D swarmalators and Jaranian lifts",
        "Bose/Jaynes-Cummings-Hubbard comparison",
        "SIGIL/KUIR/QUAZRIS typed semantic adapters"
      ]
    }
  },
