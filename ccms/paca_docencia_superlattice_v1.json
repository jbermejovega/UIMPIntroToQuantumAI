          "k-means and clustering [David, 1h]",
          "support vector machines [David, 1h]"
        ]
      },
      {
        "id": "qml",
        "title": "Quantum Machine Learning",
        "teachers": ["Juani"],
        "topics": [
          "quantum advantage",
          "re-quantization / quantum representations",
          "quantum-inspired methods",
          "quantum optimization",
          "trainability and limits",
          "duality as a change of representation: Ising/Kramers-Wannier to electric-magnetic examples"
        ]
      },
      {
        "id": "qml-models",
        "title": "Quantum Machine Learning Models",
        "teachers": ["David", "Roberta"],
        "topics": [
          "linear algebra (HHL) and linear fitting [David, 1h]",
          "quantum kernels [David, 1h]",
          "ML for and with quantum - examples [Roberta, 1h]",
          "quantum perceptron [Roberta, 1h]",
          "quantum associative memory [Roberta, 1h]",
          "quantum reservoir computing [Roberta, 2h]",
          "hands-on lecture [2h]"
        ]
      }
    ],
    "exercises": [
      {"teacher": "Juani", "exercise": "Contextual kernel: classical/quantum Ising model and duality codebook"},
      {"teacher": "Daniel", "exercise": "Neural networks for entanglement detection (classical)"},
      {"teacher": "David", "exercise": "SVM classification in classical and quantum feature spaces with PennyLane"},
      {"teacher": "Roberta", "exercise": "Critical assessment of QNN design"}
    ]
  },
  "practice_2026": {
    "id": "ising-duality-codebook",
    "audiences": ["physics", "mathematics", "computer_science"],
    "learning_targets": [
      "simulate the classical square-lattice Ising model with local Metropolis updates",
      "recover the Onsager critical scale and compute the Kramers-Wannier dual coupling",
      "recognize the Hopfield network as an Ising-like energy model without identifying it with the Onsager lattice model",
      "solve a small transverse-field Ising model by exact diagonalization",
      "represent genus-2 Z2 homology sectors as H1(Sigma_2,Z2) ~= Z2^4",
      "distinguish local spin updates from non-contractible logical/loop operations",
      "use Montonen-Olive/S-duality as an advanced electric-magnetic strong/weak duality example, not as a Monte Carlo update rule",
      "construct and validate a contextual kernel from physical/computational observables"
    ],
    "evaluation": {
      "implementation": 0.3,
      "physics_and_mathematics": 0.3,
      "kernel_and_data_analysis": 0.2,
      "critical_interpretation": 0.2
    }
  },
